    "vika": {
      "id": "vika",
      "name": "逐电·维珂",
      "title": "远路寻迹者",
      "rarity": 5,
      "element": "thunder",
      "role": "dps",
      "gender": "female",
      "baseStats": {
        "hp": 1050,
        "atk": 125,
        "def": 75,
        "spd": 112,
        "cri": 0.12,
        "criDmg": 1.5
      },
