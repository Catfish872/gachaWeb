        "hp": 100,
        "atk": 6,
        "def": 4,
        "spd": 0
      },
      "skills": [
        "vika_normal",
        "vika_skill",
        "vika_ult"
      ],
      "passiveId": "vika_passive",
      "passiveDesc": "雷属性队友行动对导电目标造成生命伤害后，维珂对存活目标追加面板攻击力18%的雷属性贯穿追击，每次行动对每个目标触发一次，每回合对每个目标最多触发两次。追击无视防御且无法暴击。",
      "synergyIds": [
        "thunder_trio"
      ],
      "description": "往来于旧城与远路的寻迹者，使用折叠雷弩寻找遗失的货物，也把亲自走过的道路画进旅行图册。她给每笔委托算得清楚，却总愿意为值得一看的地方多留几页空白。",
      "flavorText": "「前面那家店我记在地图上了。你陪我去看看，回来再告诉我画得准不准。」",
      "color": "#debb73",
      "colorDark": "#24213e",
      "image": "res://assets/content_v290/characters/vika.png",
      "portrait": "res://assets/content_v290/characters/vika.png",
      "portraitBackground": "res://assets/content_v290/backgrounds/storm_market.png",
      "passiveIconPath": "res://assets/content_v290/icons/skills/vika_passive.png",
      "relicObjective": {
        "type": "damage",
        "label": "导电协同",
        "referenceStatuses": [
          "thunder_mark"
        ],
        "recommendedSets": [
          {
            "setId": "storm_tracer",
            "reason": "提高维珂的导电追击伤害，兼顾雷属性队友触发的协同攻击。"
          }
        ]
      },
      "conductFollowUp": 0.18
    },
