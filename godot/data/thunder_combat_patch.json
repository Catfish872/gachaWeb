      "passiveIconPath": "res://assets/content_v290/icons/skills/raisa_passive.png",
      "relicObjective": {
        "type": "damage",
        "label": "雷铠循环",
        "referenceStatuses": [],
        "recommendedSets": [
          {
            "setId": "storm_armor",
            "reason": "提高雷铠状态下的伤害，配合常态积蓄能量后的连续行动。"
          }
        ]
      },
      "thunderArmor": {
        "duration": 4,
        "chargeBonus": 0.25,
