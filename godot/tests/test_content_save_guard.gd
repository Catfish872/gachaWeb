extends SceneTree
const Guard = preload("res://scripts/content_save_guard.gd")
var errors := 0
func check(value: bool, label: String) -> void:
	if not value:
		push_error(label)
		errors += 1
func write(path: String, value: String) -> void:
	var file := FileAccess.open(path, FileAccess.WRITE)
	assert(file != null)
	file.store_string(value)
	file.close()
func _initialize() -> void:
	var root := "user://save-guard-test-" + str(Time.get_ticks_usec())
	var saves := root.path_join("saves")
	var backup := root.path_join("snapshot")
	DirAccess.make_dir_recursive_absolute(saves)
	write(saves.path_join("slot1.json"), "original-save")
	write(saves.path_join("active_slot.json"), "original-active-slot")
	write(saves.path_join("slot3.json.tmp"), "original-temp")
	check(Guard.capture(backup, saves) == OK, "Capture existing slots")
	check(Guard.validate(backup), "Validate backup")
	check(Guard.capture(backup, saves) == ERR_ALREADY_EXISTS, "Protect existing snapshot")
	write(saves.path_join("slot1.json"), "migrated-save")
	write(saves.path_join("slot2.json"), "new-slot")
	write(saves.path_join("active_slot.json"), "changed-active-slot")
	write(saves.path_join("slot3.json.tmp"), "changed-temp")
	check(Guard.restore(backup, saves) == OK, "Restore failed activation")
	check(FileAccess.get_file_as_string(saves.path_join("slot1.json")) == "original-save", "Restore bytes exactly")
	check(FileAccess.get_file_as_string(saves.path_join("active_slot.json")) == "original-active-slot", "Restore selected slot")
	check(FileAccess.get_file_as_string(saves.path_join("slot3.json.tmp")) == "original-temp", "Restore interrupted save")
	check(not FileAccess.file_exists(saves.path_join("slot2.json")), "New slot absent from old state")
	check(FileAccess.get_file_as_string(backup.path_join("failed-slot2.json")) == "new-slot", "Preserve newly created slot")
	check(Guard.restore(backup, saves) == OK, "Recovery is idempotent")
	write(backup.path_join("slot1.json"), "corrupt-backup")
	write(saves.path_join("slot1.json"), "live-save")
	check(not Guard.validate(backup), "Reject corrupt snapshot")
	check(Guard.restore(backup, saves) == ERR_FILE_CORRUPT, "Corruption blocks recovery")
	check(FileAccess.get_file_as_string(saves.path_join("slot1.json")) == "live-save", "Corrupt backup preserves live save")
	var empty_backup := root.path_join("empty-snapshot")
	var absent_saves := root.path_join("absent-saves")
	check(Guard.capture(empty_backup, absent_saves) == OK, "First launch captures absent saves")
	DirAccess.make_dir_recursive_absolute(absent_saves)
	write(absent_saves.path_join("slot1.json"), "new-player-save")
	check(Guard.restore(empty_backup, absent_saves) == OK, "First launch recovery")
	check(not FileAccess.file_exists(absent_saves.path_join("slot1.json")), "Restore absent first-launch slot")
	print("content_save_guard: ", "PASS" if errors == 0 else "FAIL", " (", errors, " failures)")
	quit(0 if errors == 0 else 1)
