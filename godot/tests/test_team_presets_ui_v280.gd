extends "res://tests/test_lantern_journey_ui_v270.gd"
func capture(label:String)->void:
	await RenderingServer.frame_post_draw
	root.get_texture().get_image().save_png("res://validation/v280-focused/"+label+".png")
func named(node_name: String) -> Node: return app.find_child(node_name, true, false)
func click(node_name: String) -> void:
	var button = named(node_name)
	ck(button is Button, node_name + " exists")
	if button is Button: button.pressed.emit()
	await frames(4)
func run() -> void:
	app = load("res://main.tscn").instantiate()
	root.add_child(app)
	await frames(10)
	app.set_process(false)
	fresh()
	root.size = Vector2i(390, 844)
	await frames(8)
	app.navigate("party")
	await frames(8)
	await capture("team-presets-390")
	for index in range(5): fits(named("TeamPreset_%d" % index), "portrait preset %d" % index)
	fits(named("TeamPresetRename"), "portrait rename action")
	await click("TeamPreset_4")
	ck(app.selected_team_preset == 4 and app.model.state.activeTeamPreset == 0, "empty preset selection keeps active team")
	app._toggle_team("ember")
	app._toggle_team("ember")
	await click("TeamPresetSave")
	ck(app.model.state.team == ["zeph", "ember", null] and app.model.state.activeTeamPreset == 4, "save selected fifth preset in editing order")
	await click("TeamPresetRename")
	var entry = named("TeamPresetNameInput")
	ck(entry is LineEdit, "rename text input appears")
	if entry is LineEdit: entry.text = "风火同行"
	await click("TeamPresetRenameSave")
	ck(app.overlay.get_child_count() == 0 and app.model.state.teamPresets[4].name == "风火同行", "rename commits and dismisses")
	await click("TeamPreset_0")
	ck(app.draft_team == ["ember", "zeph"] and app.model.state.activeTeamPreset == 0, "quick switch restores first team")
	app._toggle_team("ember")
	await click("TeamPreset_4")
	ck(app.overlay.get_child_count() > 0 and app.model.state.activeTeamPreset == 0, "unsaved changes require decision")
	app._clear_overlay()
	ck(app.draft_team == ["zeph"] and app.model.state.team == ["ember", "zeph", null], "dismiss preserves draft and live team")
	app._select_team_preset(4)
	var confirm: Button = null
	for button in app.overlay.find_children("*", "Button", true, false):
		if button.text == "确认": confirm = button
	ck(confirm != null, "switch decision exposes confirm")
	if confirm != null: confirm.pressed.emit()
	await frames(4)
	ck(app.draft_team == ["zeph", "ember"] and app.overlay.get_child_count() == 0, "confirmed switch clears modal and restores saved order")
	for viewport in [Vector2i(320, 700), Vector2i(960, 540), Vector2i(1280, 720)]:
		root.size = viewport
		await frames(8)
		app.navigate("party")
		await frames(8)
		for index in range(5): fits(named("TeamPreset_%d" % index), "%s preset %d" % [viewport, index])
		fits(named("TeamPresetRename"), "%s rename action" % viewport)
		app._rename_team_preset()
		await frames(4)
		fits(named("TeamPresetNameInput"), "%s name input" % viewport)
		fits(named("TeamPresetRenameSave"), "%s rename save" % viewport)
		app._clear_overlay()
	fresh()
	ck(app.model.extraction.start_run().success, "real extraction run starts")
	app.navigate("party")
	await frames(6)
	var before: Dictionary = app.model.state.duplicate(true)
	ck(named("TeamPresetSave").disabled, "extraction locks preset saving in UI")
	for index in range(5): ck(named("TeamPreset_%d" % index).disabled, "extraction locks quick switch")
	app._toggle_team("ember")
	app._select_team_preset(0)
	ck(app.draft_team == ["ember", "zeph"] and app.model.state == before, "locked tap paths preserve live run")
	app.queue_free()
	await frames()
	print("TEAM PRESETS UI V280: %d checks, %d failures" % [checks, failures])
	quit(0 if failures == 0 else 1)
